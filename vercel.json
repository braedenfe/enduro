{
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "font/woff2" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/product-merino-short-womens.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/pages/product-cotton-short-womens.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/pages/product-wool-long-run-tee.html",
      "destination": "/shop.html",
      "permanent": false
    }
  ]
}
